# ============================================================
# DIONE WEB — Variables de entorno
# Copiar este archivo a .env.local para desarrollo local.
# En Vercel: Settings -> Environment Variables.
# Acá van solo los nombres. Los valores nunca se commitean.
# ============================================================

# --- Servidor (funciones de api/ y crons) ---
# Supabase: Project Settings -> API. La service_role saltea RLS: solo server-side.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Protege los crons (Vercel la envía como "Authorization: Bearer ...").
CRON_SECRET=

# Token de escritura de POST /api/theses (importar tesis). Inventar uno largo.
THESES_TOKEN=

# Finnhub (free tier): cotizaciones, sector e insiders.
FINNHUB_KEY=

# SEC EDGAR exige identificarse: "Nombre contacto@dominio".
SEC_USER_AGENT=

# --- Cliente (se incluyen en el bundle: nada secreto acá) ---
# Solo para desarrollo local si no hay FINNHUB_KEY.
VITE_FINNHUB_KEY=
