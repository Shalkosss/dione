{
  "rewrites": [
    {
      "source": "/api/scan",
      "destination": "/api/screener?mode=scan"
    },
    {
      "source": "/api/sectors",
      "destination": "/api/screener?mode=sectors"
    },
    {
      "source": "/api/regime",
      "destination": "/api/screener?mode=regime"
    },
    {
      "source": "/api/cron/refresh-universe",
      "destination": "/api/cron/refresh-gems?part=universe"
    },
    {
      "source": "/api/cron/refresh-universe-tech-1",
      "destination": "/api/cron/refresh-technical?part=1"
    },
    {
      "source": "/api/cron/refresh-universe-tech-2",
      "destination": "/api/cron/refresh-technical?part=2"
    },
    {
      "source": "/api/universe",
      "destination": "/api/screener?mode=universe"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/refresh-gems",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron/refresh-technical",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/cron/refresh-smart-money",
      "schedule": "0 11 * * *"
    },
    {
      "path": "/api/cron/refresh-universe",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/cron/refresh-universe-tech-1",
      "schedule": "0 13 * * *"
    },
    {
      "path": "/api/cron/refresh-universe-tech-2",
      "schedule": "0 14 * * *"
    },
    {
      "path": "/api/cron/refresh-theses",
      "schedule": "0 22 * * *"
    }
  ],
  "functions": {
    "api/cron/refresh-gems.js": {
      "maxDuration": 300
    },
    "api/cron/refresh-technical.js": {
      "maxDuration": 300
    },
    "api/cron/refresh-smart-money.js": {
      "maxDuration": 300
    },
    "api/cron/refresh-theses.js": {
      "maxDuration": 300
    },
    "api/theses.js": {
      "maxDuration": 60
    },
    "api/theses/[id].js": {
      "maxDuration": 10
    },
    "api/screener.js": {
      "maxDuration": 10
    },
    "api/smart-money.js": {
      "maxDuration": 5
    },
    "api/healthz.js": {
      "maxDuration": 5
    },
    "api/events.js": {
      "maxDuration": 30
    }
  }
}
